FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml setup.cfg ./
COPY oversolved/ oversolved/
RUN pip install --no-cache-dir .
ENV OVERSOLVED_DB_DSN=postgresql://oversolved:oversolved@postgres:5432/oversolved
ENV WORKER_INTERVAL=60
ENTRYPOINT exec python -m oversolved.cli run_tasks --loop \
    --db-type postgres \
    --db-dsn "${OVERSOLVED_DB_DSN}" \
    --interval "${WORKER_INTERVAL}"
