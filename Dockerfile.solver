FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    libgl1 \
    libglu1-mesa \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir ".[solver]"

COPY oversolved/ ./oversolved/

EXPOSE 9100

CMD ["oversolved-solver", "--host", "0.0.0.0", "--port", "9100"]
