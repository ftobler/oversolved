{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "regen:corpus": "node --experimental-strip-types --loader=./resolve-alias.loader.mjs scripts/regenCorpus.ts && python3 scripts/mergeCorpus.py",
    "shadow:wasm": "cd ../sketch-solver && wasm-pack build --target web --out-dir pkg --release && cd ../mate-solver && wasm-pack build --target web --out-dir pkg --release && cd ../frontend && node scripts/copyWasm.mjs",
    "occ:install": "npm i --no-save opencascade.js@1.1.1",
    "occ:provision": "mkdir -p public/occ && cp node_modules/opencascade.js/dist/opencascade.wasm.js node_modules/opencascade.js/dist/opencascade.wasm.wasm public/occ/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/material-icons-outlined": "^5.2.6",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "jszip": "^3.10.1",
    "mathjs": "^15.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "suspend-react": "0.1.3",
    "three": "^0.183.2",
    "three-stdlib": "2.36.1",
    "troika-three-text": "0.52.4",
    "yaml": "^2.8.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.0.0"
  }
}
