# Oversolved Configuration
# Copy to .env and fill in values. The app works out of the box with
# defaults (admin/admin) — these env vars are optional overrides.

# Admin password. Defaults to "admin" if not set.
# OVERSOLVED_ADMIN_PASSWORD=change-me

# Security: Set "true" in production to mark session cookies as Secure
# (only sent over HTTPS). Defaults to "false" (safe for local dev).
# OVERSOLVED_SESSION_COOKIE_SECURE=true

# Solver daemon address (default: 127.0.0.1:9100)
# SOLVER_DAEMON_HOST=127.0.0.1
# SOLVER_DAEMON_PORT=9100

# SQLite database path. This is a CLI flag, not an environment variable:
# `oversolved run_server --db-type sqlite --db-path oversolved.db`
# (default when omitted: :memory:).

# Database
OVERSOLVED_DB_DSN=postgresql://oversolved:oversolved@localhost:5432/oversolved
TEST_DB_DSN=postgresql://oversolved:oversolved@localhost:5432/oversolved_test

# File storage
OVERSOLVED_UPLOAD_DIR=/data/uploads

# Server
GUNICORN_WORKERS=2

# Solver daemon
SOLVER_DAEMON_HOST=127.0.0.1
SOLVER_DAEMON_PORT=9100

# Worker
WORKER_INTERVAL=60

# Frontend dev
VITE_API_PROXY=http://localhost:5000
